# DevContext Root GitIgnore #

# Node / Frontend Build Outputs
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
.npm
*.log

# Python / Backend Outputs
__pycache__/
backend/__pycache__/
backend/app/__pycache__/
backend/app/*/__pycache__/
*.py[cod]
*$py.class
backend/venv/
backend/.venv/
env/
venv/
ENV/

# Temporary / Cached Repositories
backend/cloned_repos/
cloned_repos/
*.tmp

# Environment Variables & Secrets
.env
.env.local
.env.production
*.env

# IDE / OS Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Test & Coverage Outputs
.pytest_cache/
coverage/
.coverage
